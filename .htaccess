# POMGT · Apache / LiteSpeed (cPanel, Hostinger, etc.)
# Dominio canónico: https://www.pomgt.com (con www, siempre HTTPS)
Options -Indexes
RewriteEngine On
# pomgt.com -> www.pomgt.com
RewriteCond %{HTTP_HOST} ^pomgt\.com$ [NC]
RewriteRule ^ https://www.pomgt.com%{REQUEST_URI} [R=301,L]
# http -> https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.pomgt.com%{REQUEST_URI} [R=301,L]
# /index.html -> /   y   /en/index.html -> /en/
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Páginas de error por idioma
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404.html
</If>

# Tipos MIME
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
AddType font/woff .woff
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .xml .txt .svg .webmanifest

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml application/manifest+json text/plain
</IfModule>

# Caché (HTML y sitemaps siempre frescos; recursos estáticos 30 días)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^galeria-imagenes\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
